# Copy this file to .env ON THE SERVER ONLY and fill in real values.
# .env is in .gitignore, so it is never committed. See DEPLOY.md.

# The password you type to open the app
APP_PASSWORD=change-me-to-a-long-password

# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-the-random-string-here

# Only send the login cookie over https (the hosted site uses https)
SESSION_COOKIE_SECURE=1

# Optional: where the database file lives (default: recipes.db in the app folder)
# DB_PATH=/home/yourusername/recipes.db
